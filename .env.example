# Server port
PORT=5000

# URL of the Next.js client (used for Stripe redirect URLs)
CLIENT_URL=http://localhost:3000
# Optional comma-separated additional exact origins (for example Vercel Preview URLs).
CLIENT_ORIGINS=

# MongoDB connection string (same database the client uses)
DB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/wedplan-system

# Shared secret used to sign/verify JWTs (must match the client's JWT_SECRET)
JWT_SECRET=change-me-to-a-long-random-string

# ImgBB API key used for service/profile image uploads (https://api.imgbb.com/)
IMGBB_API_KEY=

# Stripe test-mode keys only. Premium is billed at $49/month.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
